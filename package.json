{
  "name": "word-rally",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "RALLY_DATA_NAMESPACE=test tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "words:sync": "node scripts/sync-words.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests scripts *.ts *.json *.md",
    "test:redis": "node scripts/test-redis.mjs",
    "benchmark:reads": "node scripts/benchmark-reads.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.10",
    "redis": "^6.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}

      "html": "<div class=\"ds-keyboard\" role=\"group\" aria-label=\"On-screen keyboard sample\"><div class=\"ds-key-row\"><button class=\"ds-key \" aria-label=\"Q\">Q</button><button class=\"ds-key \" aria-label=\"W\">W</button><button class=\"ds-key ds-key-correct\" aria-label=\"E, correct\">E</button><button class=\"ds-key ds-key-present\" aria-label=\"R, present\">R</button><button class=\"ds-key ds-key-absent\" aria-label=\"T, absent\">T</button><button class=\"ds-key \" aria-label=\"Y\">Y</button><button class=\"ds-key \" aria-label=\"U\">U</button><button class=\"ds-key \" aria-label=\"I\">I</button><button class=\"ds-key \" aria-label=\"O\">O</button><button class=\"ds-key \" aria-label=\"P\">P</button></div><div class=\"ds-key-row\"><button class=\"ds-key \" aria-label=\"A\">A</button><button class=\"ds-key \" aria-label=\"S\">S</button><button class=\"ds-key \" aria-label=\"D\">D</button><button class=\"ds-key \" aria-label=\"F\">F</button><button class=\"ds-key \" aria-label=\"G\">G</button><button class=\"ds-key \" aria-label=\"H\">H</button><button class=\"ds-key \" aria-label=\"J\">J</button><button class=\"ds-key \" aria-label=\"K\">K</button><button class=\"ds-key \" aria-label=\"L\">L</button></div><div class=\"ds-key-row\"><button class=\"ds-key ds-wide\">ENTER</button><button class=\"ds-key \" aria-label=\"Z\">Z</button><button class=\"ds-key \" aria-label=\"X\">X</button><button class=\"ds-key \" aria-label=\"C\">C</button><button class=\"ds-key \" aria-label=\"V\">V</button><button class=\"ds-key \" aria-label=\"B\">B</button><button class=\"ds-key \" aria-label=\"N\">N</button><button class=\"ds-key \" aria-label=\"M\">M</button><button class=\"ds-key ds-wide\" aria-label=\"Delete letter\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Z\"/><path d=\"m18 9-6 6m0-6 6 6\"/></svg></button></div></div>",
      "css": ".ds-keyboard{width:min(100%,490px);display:grid;gap:6px;user-select:none}.ds-key-row{display:flex;gap:5px;justify-content:center}.ds-key-row:nth-child(2){padding-inline:20px}.ds-key{display:grid;place-items:center;background:#e7ebe3;border:0;border-radius:5px;color:var(--ink,#24352d);height:46px;flex:1;max-width:43px;padding:0;font-family:Manrope,Arial,sans-serif;font-size:12px;font-weight:800;cursor:pointer;transition:background .1s,transform .1s}.ds-key:hover:not(:disabled){background:#cfdac5}.ds-key:active:not(:disabled){transform:translateY(2px)}.ds-key:focus-visible{outline:3px solid var(--gold,#957121);outline-offset:4px;}.ds-key.ds-wide{flex:1.6;max-width:65px;font-size:10px}.ds-key.ds-key-correct{background:var(--green,#426c48);color:white}.ds-key.ds-key-present{background:var(--gold,#957121);color:white}.ds-key.ds-key-absent{background:var(--stone,#6b746d);color:white}.ds-key:disabled{opacity:.65;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-key{transition:none}}"

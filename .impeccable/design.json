      "css": ".ds-tiles{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;width:min(100%,310px)}.ds-tile{aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:white;border:2px solid #d3dccc;border-radius:4px;font-family:Manrope,Arial,sans-serif;font-weight:800;font-size:29px;line-height:1;color:var(--ink,#24352d)}.ds-tile.ds-correct{background:var(--green,#426c48);border-color:var(--green,#426c48);color:white}.ds-tile.ds-present{background:var(--gold,#957121);border-color:var(--gold,#957121);color:white}.ds-tile.ds-absent{background:var(--stone,#6b746d);border-color:var(--stone,#6b746d);color:white}"

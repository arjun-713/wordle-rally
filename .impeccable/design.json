  "narrative": {
    "northStar": "The tabletop word arena.",
    "overview": "Word Rally feels like friends gathering around a well-made word game: chalk-white paper, forest-green pieces, mustard-gold feedback, rounded lettering, and precise five-column grids. The material comes from the game itself. Letters, score slips, and softly lifted pieces provide the character.\n\nThe same world becomes quieter around live play. Reading, entering a guess, seeing the remaining time, and comparing scores take priority over decoration. This document records the implemented reusable system. Route modes, narrative order, preview composition, and the development direction contract belong in `.impeccable/surfaces/app-page-tsx.md`.",
    "keyCharacteristics": [
      "Rounded display lettering paired with compact, clear operational type.",
      "Stable semantic letter colors shared by boards and keyboards.",
      "Tonal paper surfaces with thin separators and selective soft lift.",
      "Responsive density that keeps the board and touch keyboard together."
    ],
    "rules": [
      {
        "name": "The Shared Feedback Rule",
        "body": "Correct, present, and absent states keep the same meaning on the board, keyboard, and legend. Retain written descriptions and accessible letter-state names alongside color.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Fredoka for identity and headings; use Manrope for operational information and game characters. Preserve the heavier weight of letter tiles and keys.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve shared letter-state meaning across tiles, keys, accessible names, and the legend.",
      "Do use the local Fredoka and Manrope assets with their declared variable weight ranges.",
      "Do keep important actions, timer, board, and touch keyboard legible when changing phone layouts.",
      "Do reserve shadows for the existing material roles and keep operational letter grids aligned.",
      "Do pair color feedback with text and visible focus, and honor reduced-motion preferences."
    ],
    "donts": [
      "Don't replace absent-letter stone with a low-contrast decorative gray or lighten gold behind white letter text.",
      "Don't promote preview scores, players, or timestamps into claims about actual room activity.",
      "Don't copy decorative board rotation onto the playable matrix.",
      "Don't turn this document into a route-composition plan or expose the development direction contract in the interface."
    ]
  }
}
